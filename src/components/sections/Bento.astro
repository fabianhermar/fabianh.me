---
import { UTCClock } from '@/components/bento/Clock'
import Education from '@/components/bento/Education.astro'
import Hobbies from '@/components/bento/Hobbies.astro'
import CurrentWeather from '@/components/bento/Weather'
import WhoIAm from '@/components/bento/WhoIAm.astro'
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section
	id='about-me'
	aria-labelledby='about-heading'
	class='border-b border-[var(--border-subtle)] py-16 md:py-24'
>
	<Container>
		<!-- Section Header -->
		<div class='mb-12 grid grid-cols-1 items-end gap-4 md:grid-cols-12'>
			<div class='md:col-span-8'>
				<div class='mb-2 flex items-center gap-2'>
					<span class='section-number'>03</span>
					<span class='h-px w-8 bg-[var(--border-default)]' aria-hidden='true'></span>
					<span class='font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]'>
						Bento Overview
					</span>
				</div>
				<h2 id='about-heading' class='text-scale-h1 text-[var(--text-primary)]'>
					{i18n.landing.moreinfo.title}
				</h2>
			</div>
			<div class='md:col-span-4 md:text-right'>
				<p class='font-mono text-xs text-[var(--text-muted)]'>
					5 módulos · Datos en tiempo real
				</p>
			</div>
		</div>

		<!-- 2026 Bento Grid (12 cols on desktop, 1 col on mobile in logical reading order) -->
		<div class='grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5'>
			<!-- Card 1: Personal Summary & Skills (7 cols) -->
			<article class='surface-card surface-card-interactive flex flex-col justify-between p-6 md:p-7 lg:col-span-7'>
				<header class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
					<div class='flex items-center gap-2.5'>
						<span class='inline-flex size-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--accent)]'>
							<LineIcon name='user' class='size-4' />
						</span>
						<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
							{i18n.landing.moreinfo.who.title}
						</h3>
					</div>
					<span class='font-mono text-[11px] text-[var(--text-muted)]'>01 / 05</span>
				</header>
				<WhoIAm />
			</article>

			<!-- Card 2: Current Time with Mexico Offset (5 cols, Visual Tabular Card) -->
			<article
				data-bento-ambient
				class='surface-card surface-card-interactive bento-ambient-card group flex flex-col justify-between p-6 md:p-7 lg:col-span-5'
			>
				<header class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
					<div class='flex items-center gap-2.5'>
						<span class='inline-flex size-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--accent)]'>
							<LineIcon name='clock' class='size-4' />
						</span>
						<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
							{i18n.landing.bento.time.title}
						</h3>
					</div>
					<span class='font-mono text-[11px] text-[var(--text-muted)]'>02 / 05</span>
				</header>
				<UTCClock client:visible currentLocale={currentLocale} />
			</article>

			<!-- Card 3: Current Weather Live Data (5 cols, Visual Tabular Card) -->
			<article
				data-bento-ambient
				class='surface-card surface-card-interactive bento-ambient-card group flex flex-col justify-between p-6 md:p-7 lg:col-span-5'
			>
				<header class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
					<div class='flex items-center gap-2.5'>
						<span class='inline-flex size-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--accent)]'>
							<LineIcon name='cloud-sun' class='size-4' />
						</span>
						<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
							{i18n.landing.bento.weather.title}
						</h3>
					</div>
					<span class='font-mono text-[11px] text-[var(--text-muted)]'>03 / 05</span>
				</header>
				<CurrentWeather client:visible currentLocale={currentLocale} />
			</article>

			<!-- Card 4: Education (7 cols, Sober Card) -->
			<article class='surface-card surface-card-interactive flex flex-col justify-between p-6 md:p-7 lg:col-span-7'>
				<header class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
					<div class='flex items-center gap-2.5'>
						<span class='inline-flex size-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--accent)]'>
							<LineIcon name='graduation-cap' class='size-4' />
						</span>
						<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
							{i18n.landing.bento.education.title}
						</h3>
					</div>
					<span class='font-mono text-[11px] text-[var(--text-muted)]'>04 / 05</span>
				</header>
				<Education />
			</article>

			<!-- Card 5: Hobbies (12 cols, Sober Horizontal Card) -->
			<article class='surface-card surface-card-interactive flex flex-col justify-between p-6 md:p-7 lg:col-span-12'>
				<header class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
					<div class='flex items-center gap-2.5'>
						<span class='inline-flex size-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--accent)]'>
							<LineIcon name='compass' class='size-4' />
						</span>
						<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
							{i18n.landing.bento.hobbies.title || 'Hobbies'}
						</h3>
					</div>
					<span class='font-mono text-[11px] text-[var(--text-muted)]'>05 / 05</span>
				</header>
				<Hobbies />
			</article>
		</div>
	</Container>
</section>

<style>
	.bento-ambient-card[data-period='day'] {
		background-color: var(--bento-day-bg);
	}
	.bento-ambient-card[data-period='night'] {
		background-color: var(--bento-night-bg);
	}
</style>

<script>
	function applyBentoAmbientPeriod() {
		const hour = new Date().getHours()
		const period = hour >= 6 && hour < 19 ? 'day' : 'night'
		document.querySelectorAll('[data-bento-ambient]').forEach((el) => {
			el.setAttribute('data-period', period)
		})
	}
	applyBentoAmbientPeriod()
	document.addEventListener('astro:after-swap', applyBentoAmbientPeriod)
</script>
