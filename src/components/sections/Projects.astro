---
import Container from '@/components/common/Container.astro'
import ProjectsCard from '@/components/features/ProjectsCard.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import { getI18N } from '@/i18n'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
const labels = i18n.landing.projects.labels
---

<section
	id='projects'
	aria-labelledby='projects-heading'
	class='border-b border-[var(--border-subtle)] py-16 md:py-24'
>
	<Container>
		<!-- Section Header (No letter-by-letter H1!) -->
		<div class='mb-12 grid grid-cols-1 items-end gap-4 md:grid-cols-12'>
			<div class='md:col-span-8'>
				<div class='mb-2 flex items-center gap-2'>
					<span class='section-number'>01</span>
					<span class='h-px w-8 bg-[var(--border-default)]' aria-hidden='true'></span>
					<span class='font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]'>
						Case Studies
					</span>
				</div>
				<h2 id='projects-heading' class='text-scale-h1 text-[var(--text-primary)]'>
					{i18n.landing.projects.title}
				</h2>
			</div>
			<div class='md:col-span-4 md:text-right'>
				<p class='text-sm text-[var(--text-secondary)]'>
					{i18n.landing.projects.subtitle}
				</p>
			</div>
		</div>

		<!-- Ordered Case Studies: 1. ClearCut Studio, 2. Boxode, 3. Dune UI -->
		<div class='flex flex-col gap-8'>
			<ProjectsCard
				projectNumber='01'
				projectImage='/projects/ClearCutStudio.avif'
				externalLink='https://studio.fabianh.me'
				githubLink='https://github.com/fabianhermar/clearcut-studio'
				title={i18n.landing.projects.project3.title}
				subtitle={i18n.landing.projects.project3.subtitle}
				year={i18n.landing.projects.project3.year}
				problem={i18n.landing.projects.project3.problem}
				decision={i18n.landing.projects.project3.decision}
				result={i18n.landing.projects.project3.result}
				labels={labels}
				technologies={[
					{ text: 'Next.js' },
					{ text: 'TypeScript' },
					{ text: 'AI Models' },
					{ text: 'WebP / AVIF' },
				]}
			/>

			<ProjectsCard
				projectNumber='02'
				projectImage='/projects/Boxode.avif'
				externalLink='https://boxode.org'
				githubLink={null}
				title={i18n.landing.projects.project4.title}
				subtitle={i18n.landing.projects.project4.subtitle}
				year={i18n.landing.projects.project4.year}
				problem={i18n.landing.projects.project4.problem}
				decision={i18n.landing.projects.project4.decision}
				result={i18n.landing.projects.project4.result}
				labels={labels}
				technologies={[
					{ text: 'Next.js' },
					{ text: 'React' },
					{ text: 'TypeScript' },
					{ text: 'TailwindCSS' },
				]}
			/>

			<ProjectsCard
				projectNumber='03'
				projectImage='/projects/DuneUI.webp'
				externalLink='https://ui.fabianh.me'
				githubLink='https://github.com/fabianhermar/duneui'
				title={i18n.landing.projects.project1.title}
				subtitle={i18n.landing.projects.project1.subtitle}
				year={i18n.landing.projects.project1.year}
				problem={i18n.landing.projects.project1.problem}
				decision={i18n.landing.projects.project1.decision}
				result={i18n.landing.projects.project1.result}
				labels={labels}
				technologies={[
					{ text: 'Astro' },
					{ text: 'React' },
					{ text: 'TypeScript' },
					{ text: 'TailwindCSS' },
				]}
			/>
		</div>

		<!-- Secondary link to full archive -->
		<div class='mt-10 flex justify-end'>
			<a
				href={translatePath('/proyectos')}
				class='group inline-flex items-center gap-2 rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] px-5 py-2.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--border-strong)] hover:bg-[var(--bg-elevated)]'
			>
				<span>{labels.all}</span>
				<LineIcon
					name='arrow-right'
					class='size-4 text-[var(--text-muted)] transition-transform group-hover:translate-x-0.5'
				/>
			</a>
		</div>
	</Container>
</section>
