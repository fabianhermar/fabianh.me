---
import Container from '@/components/common/Container.astro'
import ExperienceCard from '@/components/features/ExperienceCard.astro'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section
	id='experience'
	aria-labelledby='experience-heading'
	class='border-b border-[var(--border-subtle)] py-16 md:py-24'
>
	<Container>
		<!-- Section Header -->
		<div class='mb-12 grid grid-cols-1 items-end gap-4 md:grid-cols-12'>
			<div class='md:col-span-8'>
				<div class='mb-2 flex items-center gap-2'>
					<span class='section-number'>02</span>
					<span class='h-px w-8 bg-[var(--border-default)]' aria-hidden='true'></span>
					<span class='font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]'>
						Track Record
					</span>
				</div>
				<h2 id='experience-heading' class='text-scale-h1 text-[var(--text-primary)]'>
					{i18n.landing.WIW.title}
				</h2>
			</div>
			<div class='md:col-span-4 md:text-right'>
				<p class='text-sm text-[var(--text-secondary)]'>
					{i18n.landing.WIW.subtitle}
				</p>
			</div>
		</div>

		<!-- Compact Timeline List -->
		<ol class='flex flex-col gap-5'>
			<li>
				<ExperienceCard
					index='01'
					title={i18n.landing.WIW.card1.title}
					location={i18n.landing.WIW.card1.location}
					duration={i18n.landing.WIW.card1.duration}
					bullets={i18n.landing.WIW.card1.bullets}
					technologies={[
						{ text: 'Astro' },
						{ text: 'TypeScript' },
						{ text: 'TailwindCSS' },
						{ text: i18n.landing.WIW.card1.tech.tech1 },
					]}
				/>
			</li>

			<li>
				<ExperienceCard
					index='02'
					title={i18n.landing.WIW.card2.title}
					location={i18n.landing.WIW.card2.location}
					duration={i18n.landing.WIW.card2.duration}
					bullets={i18n.landing.WIW.card2.bullets}
					technologies={[
						{ text: i18n.landing.WIW.card2.tech.tech1 },
						{ text: i18n.landing.WIW.card2.tech.tech2 },
						{ text: i18n.landing.WIW.card2.tech.tech3 },
						{ text: i18n.landing.WIW.card2.tech.tech4 },
					]}
				/>
			</li>

			<li>
				<ExperienceCard
					index='03'
					link='https://www.facebook.com/InstitutoNielsBohr'
					target='_blank'
					title={i18n.landing.WIW.card3.title}
					location={i18n.landing.WIW.card3.location}
					duration={i18n.landing.WIW.card3.duration}
					bullets={i18n.landing.WIW.card3.bullets}
					technologies={[
						{ text: 'PHP' },
						{ text: 'MySQL' },
						{ text: 'JavaScript' },
						{ text: i18n.landing.WIW.card3.tech.tech1 },
					]}
				/>
			</li>
		</ol>
	</Container>
</section>
