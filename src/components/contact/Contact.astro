---
import ContactForm from '@/components/contact/ContactForm'
import LineIcon from '@/components/ui/LineIcon.astro'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10'>
	<!-- Primary Path: Featured Contact Form Card (8 cols on desktop) -->
	<div class='surface-card p-6 md:p-8 lg:col-span-8 lg:p-10'>
		<div class='mb-6 border-b border-[var(--border-subtle)] pb-4'>
			<h3 class='text-scale-h2 text-[var(--text-primary)]'>
				{i18n.landing.contact.form.contactForm.title}
			</h3>
			<p class='mt-1 text-sm text-[var(--text-secondary)]'>
				{i18n.landing.contact.form.subtitle}
			</p>
		</div>

		<ContactForm client:visible currentLocale={currentLocale} />

		<p class='mt-6 border-t border-[var(--border-subtle)] pt-4 text-xs leading-relaxed text-[var(--text-muted)]'>
			{i18n.landing.contact.form.contactForm.footer}
		</p>
	</div>

	<!-- Secondary Compact Options: Direct Email & Social Networks (4 cols on desktop) -->
	<aside class='flex flex-col justify-between gap-6 lg:col-span-4'>
		<div class='surface-card p-6 md:p-7'>
			<div class='inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-1 text-xs font-medium text-[var(--text-secondary)]'>
				<span class='size-2 rounded-full bg-[var(--status-online)]'></span>
				<span>{i18n.landing.available}</span>
			</div>

			<h3 class='mt-4 text-scale-h3 text-[var(--text-primary)]'>
				{i18n.landing.contact.form.alternatives.title}
			</h3>
			<p class='mt-2 text-sm leading-relaxed text-[var(--text-secondary)]'>
				{i18n.landing.contact.form.alternatives.subtitle}
			</p>

			<!-- Direct Email Button -->
			<div class='mt-5'>
				<a
					href='mailto:ctofabian@gmail.com'
					class='group flex items-center justify-between rounded-lg border border-[var(--border-default)] bg-[var(--bg-elevated)] px-4 py-3 text-sm font-mono font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--accent)]'
				>
					<span class='flex items-center gap-2.5 truncate'>
						<LineIcon name='mail' class='size-4 shrink-0 text-[var(--accent)]' />
						<span class='truncate'>ctofabian@gmail.com</span>
					</span>
					<LineIcon
						name='arrow-up-right'
						class='size-4 shrink-0 text-[var(--text-muted)] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--accent)]'
					/>
				</a>
			</div>

			<!-- Compact Social Links -->
			<div class='mt-6 border-t border-[var(--border-subtle)] pt-5'>
				<span class='block font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]'>
					Perfiles profesionales
				</span>
				<div class='mt-3 grid grid-cols-2 gap-2'>
					<a
						href='https://github.com/FabianHermar'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='GitHub de Fabian Herrera'
						class='flex items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='github' class='size-3.5' />
						<span>GitHub</span>
					</a>

					<a
						href='https://www.linkedin.com/in/fabianhmz'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='LinkedIn de Fabian Herrera'
						class='flex items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='linkedin' class='size-3.5' />
						<span>LinkedIn</span>
					</a>

					<a
						href='https://x.com/FabianHermar'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='Perfil de X (Twitter) de Fabian Herrera'
						class='flex items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='x' class='size-3.5' />
						<span>X / Twitter</span>
					</a>

					<a
						href='https://discord.com/users/607805987541352468'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='Contactar por Discord'
						class='flex items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='discord' class='size-3.5' />
						<span>Discord</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Resume / CV Card -->
		<div class='surface-card flex items-center justify-between gap-4 p-5'>
			<div>
				<p class='font-heading text-sm font-bold text-[var(--text-primary)]'>
					Currículum Vitae
				</p>
				<p class='font-mono text-xs text-[var(--text-muted)]'>
					PDF · Español / Inglés
				</p>
			</div>
			<div class='flex items-center gap-2'>
				<a
					href='/FabianHerrera_CV.pdf'
					download='FabianHerreraCV.pdf'
					aria-label='Descargar CV en PDF'
					class='inline-flex h-9 items-center gap-1.5 rounded-md border border-[var(--border-default)] bg-[var(--bg-elevated)] px-3 text-xs font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--border-strong)]'
				>
					<LineIcon name='download' class='size-3.5' />
					<span>PDF</span>
				</a>
				<a
					href='https://drive.google.com/file/d/1UKzGLJSSRQ5h7mvoZD7lJGE2NGqEX3pg/view?usp=sharing'
					target='_blank'
					rel='noopener noreferrer'
					aria-label='Ver CV digital en Google Drive'
					class='inline-flex h-9 items-center gap-1 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] px-2.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
				>
					<LineIcon name='arrow-up-right' class='size-3.5' />
				</a>
			</div>
		</div>
	</aside>
</div>
