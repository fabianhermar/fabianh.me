---
interface Props {
	text: string
	image?: string
	class?: string
}

const { text, class: className = '' } = Astro.props
---

<span
	class={`surface-pill inline-flex items-center px-2.5 py-1 font-mono text-xs font-medium tracking-tight text-[var(--text-secondary)] select-none ${className}`}
>
	{text}
</span>
