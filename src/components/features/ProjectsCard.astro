---
import LineIcon from '@/components/ui/LineIcon.astro'
import Pill from '@/components/ui/pill.astro'
import { Image } from 'astro:assets'

interface Technologies {
	text: string
	image?: string
}

interface ProjectsCardProps {
	projectImage: string
	externalLink: string
	githubLink: string | null
	target?: string
	title: string
	subtitle: string
	year?: string
	problem: string
	decision: string
	result: string
	labels: {
		problem: string
		decision: string
		result: string
		live: string
		code: string
	}
	technologies: Technologies[]
	projectNumber?: string
}

const {
	projectImage,
	externalLink,
	githubLink,
	target = '_blank',
	title,
	subtitle,
	year = '2025',
	problem,
	decision,
	result,
	labels,
	technologies,
	projectNumber = '01',
} = Astro.props as ProjectsCardProps
---

<article class='surface-card surface-card-interactive reveal-on-scroll overflow-hidden p-6 md:p-8 lg:p-10'>
	<div class='grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10'>
		<!-- Case Study Content (7 cols) -->
		<div class='flex flex-col justify-between lg:col-span-7'>
			<div>
				<!-- Top Metadata Row -->
				<div class='flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4'>
					<div class='flex items-center gap-3'>
						<span class='font-mono tabular-nums text-xs font-semibold text-[var(--accent)]'>
							/{projectNumber}
						</span>
						<span class='h-3.5 w-px bg-[var(--border-subtle)]' aria-hidden='true'></span>
						<span class='font-mono tabular-nums text-xs text-[var(--text-muted)]'>
							{year}
						</span>
					</div>

					<!-- External / Repo Links -->
					<div class='flex items-center gap-2'>
						{githubLink && (
							<a
								href={githubLink}
								target={target}
								rel='noopener noreferrer'
								aria-label={`${labels.code}: ${title}`}
								class='inline-flex h-8 items-center gap-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-2.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
							>
								<LineIcon name='github' class='size-3.5' />
								<span>{labels.code}</span>
							</a>
						)}
						<a
							href={externalLink}
							target={target}
							rel='noopener noreferrer'
							aria-label={`${labels.live}: ${title}`}
							class='inline-flex h-8 items-center gap-1.5 rounded-md border border-[var(--accent-border)] bg-[var(--accent-soft)] px-3 text-xs font-semibold text-[var(--accent)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--accent-foreground)]'
						>
							<span>{labels.live}</span>
							<LineIcon name='arrow-up-right' class='size-3.5' />
						</a>
					</div>
				</div>

				<!-- Title & Subtitle -->
				<div class='mt-5'>
					<h3 class='text-scale-h2 text-[var(--text-primary)]'>
						{title}
					</h3>
					<p class='mt-1 text-sm font-medium text-[var(--text-muted)]'>
						{subtitle}
					</p>
				</div>

				<!-- Case Study Blocks: Problema -> Decisión -> Resultado (Max 3 lines each) -->
				<dl class='mt-6 grid grid-cols-1 gap-4 border-t border-[var(--border-subtle)] pt-5'>
					<div class='grid grid-cols-1 gap-1 sm:grid-cols-12 sm:gap-4'>
						<dt class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] sm:col-span-3 sm:pt-0.5'>
							{labels.problem}
						</dt>
						<dd class='text-sm leading-relaxed text-[var(--text-secondary)] line-clamp-3 sm:col-span-9'>
							{problem}
						</dd>
					</div>

					<div class='grid grid-cols-1 gap-1 border-t border-[var(--border-subtle)] pt-3.5 sm:grid-cols-12 sm:gap-4'>
						<dt class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] sm:col-span-3 sm:pt-0.5'>
							{labels.decision}
						</dt>
						<dd class='text-sm leading-relaxed text-[var(--text-secondary)] line-clamp-3 sm:col-span-9'>
							{decision}
						</dd>
					</div>

					<div class='grid grid-cols-1 gap-1 border-t border-[var(--border-subtle)] pt-3.5 sm:grid-cols-12 sm:gap-4'>
						<dt class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--accent)] sm:col-span-3 sm:pt-0.5'>
							{labels.result}
						</dt>
						<dd class='text-sm font-medium leading-relaxed text-[var(--text-primary)] line-clamp-3 sm:col-span-9'>
							{result}
						</dd>
					</div>
				</dl>
			</div>

			<!-- Stack Tags -->
			<div class='mt-6 flex flex-wrap items-center gap-2 border-t border-[var(--border-subtle)] pt-4'>
				{technologies?.map((tech) => <Pill text={tech.text} />)}
			</div>
		</div>

		<!-- Product Visual (5 cols) -->
		<div class='flex items-center lg:col-span-5'>
			<a
				href={externalLink}
				target={target}
				rel='noopener noreferrer'
				aria-label={`Ver captura y demostración de ${title}`}
				class='group relative block w-full overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)]'
			>
				<div class='flex items-center gap-1.5 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-2'>
					<span class='size-2 rounded-full bg-[var(--border-default)]'></span>
					<span class='size-2 rounded-full bg-[var(--border-default)]'></span>
					<span class='size-2 rounded-full bg-[var(--border-default)]'></span>
					<span class='ml-2 truncate font-mono text-[11px] text-[var(--text-muted)]'>
						{externalLink.replace(/^https?:\/\//, '')}
					</span>
				</div>
				<div class='aspect-[16/11] w-full overflow-hidden'>
					<Image
						src={projectImage}
						alt={`Captura de producto de ${title}`}
						class='h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]'
						width={720}
						height={495}
						loading='lazy'
					/>
				</div>
			</a>
		</div>
	</div>
</article>
