---
import { getI18N } from '@/i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class='space-y-6'>
	<div class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
		<h2 class='text-scale-h2 text-[var(--text-primary)]'>
			{i18n.styleguide.colors.title}
		</h2>
		<span class='font-mono text-xs text-[var(--text-muted)]'>01 · OKLCH()</span>
	</div>
	<p class='max-w-2xl text-sm text-[var(--text-secondary)]'>
		{i18n.styleguide.colors.description}
	</p>

	<div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'>
		<!-- Single Accent Token -->
		<div class='surface-card p-5'>
			<div class='mb-4 h-24 w-full rounded-lg bg-[var(--accent)]'></div>
			<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
				Acento Único (--accent)
			</h3>
			<div class='mt-3 space-y-1.5 font-mono text-xs text-[var(--text-muted)]'>
				<div class='flex justify-between'>
					<span>Light:</span>
					<span>oklch(0.53 0.175 36)</span>
				</div>
				<div class='flex justify-between'>
					<span>Dark:</span>
					<span>oklch(0.72 0.16 40)</span>
				</div>
			</div>
		</div>

		<!-- Light Surfaces -->
		<div class='surface-card p-5'>
			<div class='mb-4 grid h-24 w-full grid-cols-3 overflow-hidden rounded-lg border border-[var(--border-subtle)]'>
				<div style='background: oklch(0.985 0.003 85)'></div>
				<div style='background: oklch(0.996 0.002 85)'></div>
				<div style='background: oklch(0.955 0.005 85)'></div>
			</div>
			<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
				Superficies Modo Claro
			</h3>
			<div class='mt-3 space-y-1.5 font-mono text-xs text-[var(--text-muted)]'>
				<div class='flex justify-between'>
					<span>--bg-base:</span>
					<span>oklch(0.985 0.003 85)</span>
				</div>
				<div class='flex justify-between'>
					<span>--bg-surface:</span>
					<span>oklch(0.996 0.002 85)</span>
				</div>
			</div>
		</div>

		<!-- Dark Surfaces -->
		<div class='surface-card p-5'>
			<div class='mb-4 grid h-24 w-full grid-cols-3 overflow-hidden rounded-lg border border-[var(--border-subtle)]'>
				<div style='background: oklch(0.13 0.006 260)'></div>
				<div style='background: oklch(0.165 0.007 260)'></div>
				<div style='background: oklch(0.21 0.009 260)'></div>
			</div>
			<h3 class='font-heading text-base font-bold text-[var(--text-primary)]'>
				Superficies Modo Oscuro
			</h3>
			<div class='mt-3 space-y-1.5 font-mono text-xs text-[var(--text-muted)]'>
				<div class='flex justify-between'>
					<span>--bg-base:</span>
					<span>oklch(0.13 0.006 260)</span>
				</div>
				<div class='flex justify-between'>
					<span>--bg-surface:</span>
					<span>oklch(0.165 0.007 260)</span>
				</div>
			</div>
		</div>
	</div>
</section>
