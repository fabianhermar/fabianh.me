---
import LineIcon from '@/components/ui/LineIcon.astro'
import Pill from '@/components/ui/pill.astro'
import { getI18N } from '@/i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class='space-y-6'>
	<div class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
		<h2 class='text-scale-h2 text-[var(--text-primary)]'>
			{i18n.styleguide.elements.title}
		</h2>
		<span class='font-mono text-xs text-[var(--text-muted)]'>03 · SURFACES</span>
	</div>

	<div class='grid grid-cols-1 gap-6 md:grid-cols-2'>
		<div class='surface-card p-6'>
			<h3 class='text-scale-h3 text-[var(--text-primary)]'>
				{i18n.styleguide.elements.buttons.title}
			</h3>
			<div class='mt-5 flex flex-wrap items-center gap-3'>
				<button
					type='button'
					class='inline-flex h-11 items-center gap-2 rounded-lg bg-[var(--accent)] px-5 text-sm font-semibold text-[var(--accent-foreground)]'
				>
					<span>{i18n.styleguide.elements.buttons.primary}</span>
					<LineIcon name='arrow-right' class='size-4' />
				</button>

				<button
					type='button'
					class='inline-flex h-11 items-center gap-2 rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] px-4 text-sm font-medium text-[var(--text-primary)]'
				>
					<LineIcon name='download' class='size-4' />
					<span>{i18n.styleguide.elements.buttons.cv}</span>
				</button>
			</div>
			<p class='mt-4 text-xs text-[var(--text-secondary)]'>
				{i18n.styleguide.elements.buttons.description}
			</p>
		</div>

		<div class='surface-card p-6'>
			<h3 class='text-scale-h3 text-[var(--text-primary)]'>
				{i18n.styleguide.elements.pills.title}
			</h3>
			<div class='mt-5 flex flex-wrap items-center gap-2'>
				<Pill text='Astro' />
				<Pill text='React' />
				<Pill text='Next.js' />
				<Pill text='TypeScript' />
				<Pill text='TailwindCSS' />
			</div>
			<p class='mt-4 text-xs text-[var(--text-secondary)]'>
				{i18n.styleguide.elements.pills.description}
			</p>
		</div>
	</div>
</section>
