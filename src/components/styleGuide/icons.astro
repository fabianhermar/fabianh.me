---
import LineIcon from '@/components/ui/LineIcon.astro'
import { getI18N } from '@/i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const sampleIcons = [
	'arrow-up-right',
	'cloud-sun',
	'clock',
	'graduation-cap',
	'compass',
	'code',
	'layers',
	'mail',
] as const
---

<section class='space-y-6'>
	<div class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
		<h2 class='text-scale-h2 text-[var(--text-primary)]'>
			{i18n.styleguide.icons.title}
		</h2>
		<span class='font-mono text-xs text-[var(--text-muted)]'>04 · 1.75PX STROKE</span>
	</div>

	<div class='surface-card p-6'>
		<div class='grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-8'>
			{sampleIcons.map((iconName) => (
				<div class='flex flex-col items-center justify-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] p-4'>
					<LineIcon name={iconName} class='size-5 text-[var(--accent)]' />
					<span class='font-mono text-[10px] text-[var(--text-secondary)]'>{iconName}</span>
				</div>
			))}
		</div>
		<p class='mt-5 text-xs text-[var(--text-secondary)]'>
			{i18n.styleguide.icons.description}
		</p>
	</div>
</section>
