---
import { getI18N } from '@/i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class='space-y-6'>
	<div class='flex items-center justify-between border-b border-[var(--border-subtle)] pb-3'>
		<h2 class='text-scale-h2 text-[var(--text-primary)]'>
			{i18n.styleguide.typo.title}
		</h2>
		<span class='font-mono text-xs text-[var(--text-muted)]'>02 · CLAMP() SCALE</span>
	</div>

	<div class='grid grid-cols-1 gap-6 md:grid-cols-3'>
		<div class='surface-card flex flex-col justify-between p-6'>
			<div>
				<span class='surface-pill inline-block px-2.5 py-0.5 font-mono text-xs'>
					{i18n.styleguide.typo.h1}
				</span>
				<p class='mt-4 text-scale-h1 text-[var(--text-primary)]'>Albert Sans</p>
			</div>
			<p class='mt-6 border-t border-[var(--border-subtle)] pt-3 font-mono text-xs text-[var(--text-muted)]'>
				clamp(2rem, 3vw + 0.85rem, 3.25rem)
			</p>
		</div>

		<div class='surface-card flex flex-col justify-between p-6'>
			<div>
				<span class='surface-pill inline-block px-2.5 py-0.5 font-mono text-xs'>
					{i18n.styleguide.typo.h2}
				</span>
				<p class='mt-4 text-scale-h2 text-[var(--text-primary)]'>Albert Sans</p>
			</div>
			<p class='mt-6 border-t border-[var(--border-subtle)] pt-3 font-mono text-xs text-[var(--text-muted)]'>
				clamp(1.5rem, 2vw + 0.75rem, 2.25rem)
			</p>
		</div>

		<div class='surface-card flex flex-col justify-between p-6'>
			<div>
				<span class='surface-pill inline-block px-2.5 py-0.5 font-mono text-xs'>
					{i18n.styleguide.typo.small}
				</span>
				<p class='mt-4 font-heading tabular-nums text-4xl font-bold text-[var(--text-primary)]'>
					12:45:09
				</p>
			</div>
			<p class='mt-6 border-t border-[var(--border-subtle)] pt-3 font-mono text-xs text-[var(--text-muted)]'>
				font-variant-numeric: tabular-nums
			</p>
		</div>
	</div>
</section>
