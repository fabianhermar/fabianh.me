---
import LineIcon from '@/components/ui/LineIcon.astro'
import { getI18N } from '@/i18n'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
---

<div class='flex h-full flex-col justify-between gap-6 pt-3'>
	<div class='space-y-4'>
		<p class='font-serif text-lg italic text-[var(--text-primary)]'>
			{i18n.landing.moreinfo.phrase}
		</p>

		<p class='text-sm leading-relaxed text-[var(--text-secondary)]'>
			{i18n.landing.moreinfo.who['1']}
		</p>

		<p class='text-sm leading-relaxed text-[var(--text-secondary)]'>
			{i18n.landing.moreinfo.who['2'].fp}{' '}
			<span
				tabindex='0'
				class='has-tooltip relative inline-flex cursor-help items-center gap-1 rounded border border-[var(--accent-border)] bg-[var(--accent-soft)] px-1.5 py-0.5 font-mono text-xs font-medium text-[var(--accent)]'
			>
				{i18n.landing.moreinfo.who['2'].sp}
				<span
					role='tooltip'
					class='tooltip pointer-events-none absolute bottom-full left-0 z-20 mb-2 w-56 rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] p-2.5 font-mono text-[11px] leading-normal text-[var(--text-secondary)] shadow-lg'
				>
					HTML · CSS · TS · React · Next.js · Astro · Node.js · REST APIs · MongoDB · MySQL
				</span>
			</span>
			,{' '}
			<span
				tabindex='0'
				class='has-tooltip relative inline-flex cursor-help items-center gap-1 rounded border border-[var(--border-default)] bg-[var(--bg-elevated)] px-1.5 py-0.5 font-mono text-xs font-medium text-[var(--text-primary)]'
			>
				{i18n.landing.moreinfo.who['2'].tp}
				<span
					role='tooltip'
					class='tooltip pointer-events-none absolute bottom-full left-0 z-20 mb-2 w-56 rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] p-2.5 font-mono text-[11px] leading-normal text-[var(--text-secondary)] shadow-lg'
				>
					Figma · Design Systems · Wireframing · Responsive UI · Accesibilidad WCAG AA
				</span>
			</span>{' '}
			{i18n.landing.moreinfo.who['2'].ftp}{' '}
			<span
				tabindex='0'
				class='has-tooltip relative inline-flex cursor-help items-center gap-1 rounded border border-[var(--border-default)] bg-[var(--bg-elevated)] px-1.5 py-0.5 font-mono text-xs font-medium text-[var(--text-primary)]'
			>
				{i18n.landing.moreinfo.who['2'].ffp}
				<span
					role='tooltip'
					class='tooltip pointer-events-none absolute bottom-full right-0 z-20 mb-2 w-52 rounded-lg border border-[var(--border-default)] bg-[var(--bg-surface)] p-2.5 font-mono text-[11px] leading-normal text-[var(--text-secondary)] shadow-lg'
				>
					React Native · Android · iOS · TypeScript
				</span>
			</span>
		</p>

		<p class='text-sm leading-relaxed text-[var(--text-secondary)]'>
			{i18n.landing.moreinfo.who['3']}
		</p>
	</div>

	<!-- Skills Summary Row + About Link -->
	<div class='flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-4'>
		<div class='flex flex-wrap items-center gap-2'>
			<span class='surface-pill inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-xs'>
				<LineIcon name='code' class='size-3.5 text-[var(--accent)]' />
				{i18n.landing.moreinfo.who['2'].sp}
			</span>
			<span class='surface-pill inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-xs'>
				<LineIcon name='layers' class='size-3.5 text-[var(--accent)]' />
				{i18n.landing.moreinfo.who['2'].tp}
			</span>
			<span class='surface-pill inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-xs'>
				<LineIcon name='smartphone' class='size-3.5 text-[var(--accent)]' />
				{i18n.landing.moreinfo.who['2'].ffp.replace('.', '')}
			</span>
		</div>

		<a
			href={translatePath('/sobre-mi')}
			class='group inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)] hover:underline underline-offset-4'
		>
			<span>{i18n.landing.moreinfo.who.button}</span>
			<LineIcon
				name='arrow-right'
				class='size-3.5 transition-transform group-hover:translate-x-0.5'
			/>
		</a>
	</div>
</div>
