---
import LineIcon from '@/components/ui/LineIcon.astro'
import { sanitizeHtml } from '@/helpers/satinizeHTML'
import { getI18N } from '@/i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<div class='flex h-full flex-col justify-between gap-5 pt-3'>
	<div>
		<a
			href='https://utna.edu.mx'
			target='_blank'
			rel='noopener noreferrer'
			class='group block'
		>
			<div class='flex items-start justify-between gap-4'>
				<div>
					<span class='font-mono text-xs font-semibold text-[var(--accent)]'>
						UTNA · {i18n.landing.bento.education.duration}
					</span>
					<h4 class='mt-1 text-scale-h3 text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]'>
						{i18n.landing.bento.education.career}
					</h4>
				</div>
				<span class='inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-secondary)] transition-colors group-hover:border-[var(--border-strong)] group-hover:text-[var(--text-primary)]'>
					<LineIcon name='arrow-up-right' class='size-4' />
				</span>
			</div>
		</a>

		<p
			class='mt-3 text-sm leading-relaxed text-[var(--text-secondary)]'
			set:html={sanitizeHtml(i18n.landing.bento.education.description)}
		/>
	</div>

	<div class='flex flex-wrap items-center justify-between gap-2 border-t border-[var(--border-subtle)] pt-4 font-mono text-xs text-[var(--text-muted)]'>
		<span class='inline-flex items-center gap-1.5'>
			<LineIcon name='map-pin' class='size-3.5' />
			{i18n.landing.bento.education.location}
		</span>
		<span class='tabular-nums'>2019 — 2025</span>
	</div>
</div>
