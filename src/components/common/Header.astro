---
import Container from '@/components/common/Container.astro'
import LangSelector from '@/components/features/LangSelector.astro'
import ThemeToggle from '@/components/features/ThemeToggle.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Logo from '@/components/ui/Logo.astro'
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const homePath = translatePath('/')
---

<header class='sticky top-0 z-50 w-full pt-3 pb-2'>
	<Container>
		<nav
			aria-label='Navegación principal'
			class='nav-liquid-glass flex items-center justify-between rounded-xl px-3.5 py-2.5 sm:px-5'
		>
			<!-- Brand + Availability Status -->
			<div class='flex items-center gap-3 sm:gap-4'>
				<a
					href={homePath}
					aria-label='Fabian Herrera — Inicio'
					class='group flex items-center gap-2.5 text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]'
				>
					<Logo class='size-8 transition-transform duration-200 group-hover:scale-105' idSuffix='header' />
					<span class='hidden font-heading text-sm font-bold tracking-tight sm:inline-block'>
						Fabian Herrera
					</span>
				</a>

				<span class='hidden h-4 w-px bg-[var(--border-subtle)] md:inline-block' aria-hidden='true'></span>

				<!-- Availability pill: Only on desktop/tablet -->
				<a
					href={`${homePath}#contact`}
					class='hidden md:inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1 text-[11px] font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
				>
					<span class='relative flex size-2'>
						<span
							class='status-dot-pulse absolute inline-flex h-full w-full rounded-full bg-[var(--status-online)]'
						></span>
						<span class='relative inline-flex size-2 rounded-full bg-[var(--status-online)]'></span>
					</span>
					<span>{t('nav.available')}</span>
				</a>
			</div>

			<!-- Desktop Links -->
			<ul class='hidden items-center gap-1 lg:flex'>
				<li>
					<a
						href={`${homePath}#projects`}
						class='rounded-md px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
					>
						{t('nav.projects')}
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#experience`}
						class='rounded-md px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
					>
						{t('nav.experience')}
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#about-me`}
						class='rounded-md px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
					>
						{t('nav.about')}
					</a>
				</li>
				<li>
					<a
						href={translatePath('/blog')}
						class='rounded-md px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
					>
						{t('nav.blog')}
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#contact`}
						class='rounded-md px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
					>
						{t('nav.contact')}
					</a>
				</li>
			</ul>

			<!-- Actions: Command Palette + CV + Lang + Theme + Mobile Toggle -->
			<div class='flex items-center gap-2'>
				<!-- Command Palette Trigger (Desktop & Tablet only) -->
				<button
					type='button'
					data-open-cmdk
					aria-label={t('nav.command')}
					class='hidden sm:inline-flex h-9 items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
				>
					<LineIcon name='search' class='size-3.5' />
					<span class='hidden xl:inline'>{t('nav.command')}</span>
					<kbd
						class='rounded border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-muted)]'
					>
						Ctrl K
					</kbd>
				</button>

				<a
					href='/FabianHerrera_CV.pdf'
					download='FabianHerreraCV.pdf'
					aria-label={t('btn.downloadCV')}
					class='hidden h-9 items-center gap-1.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] md:inline-flex'
				>
					<LineIcon name='download' class='size-3.5' />
					<span>CV</span>
				</a>

				<div class='hidden sm:flex items-center gap-1.5'>
					<LangSelector />
					<ThemeToggle />
				</div>

				<!-- Mobile Menu Button -->
				<button
					type='button'
					id='mobile-menu-btn'
					aria-label='Abrir menú de navegación'
					aria-expanded='false'
					aria-controls='mobile-menu-panel'
					class='inline-flex size-9 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] lg:hidden'
				>
					<svg
						id='menu-icon-open'
						xmlns='http://www.w3.org/2000/svg'
						class='size-4'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='1.75'
						stroke-linecap='round'
						stroke-linejoin='round'
						aria-hidden='true'
					>
						<line x1='4' x2='20' y1='8' y2='8'></line>
						<line x1='4' x2='20' y1='16' y2='16'></line>
					</svg>
					<svg
						id='menu-icon-close'
						xmlns='http://www.w3.org/2000/svg'
						class='hidden size-4'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='1.75'
						stroke-linecap='round'
						stroke-linejoin='round'
						aria-hidden='true'
					>
						<path d='M18 6 6 18'></path>
						<path d='m6 6 12 12'></path>
					</svg>
				</button>
			</div>
		</nav>

		<!-- Mobile Navigation Drawer -->
		<div
			id='mobile-menu-panel'
			class='mt-2 hidden rounded-xl border border-[var(--border-default)] bg-[var(--bg-surface)] p-4 shadow-lg lg:hidden'
		>
			<!-- Mobile Search / Command Palette trigger -->
			<button
				type='button'
				data-open-cmdk
				data-mobile-link
				aria-label={t('nav.command')}
				class='mb-3 flex w-full items-center justify-between rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3.5 py-2.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
			>
				<div class='flex items-center gap-2'>
					<LineIcon name='search' class='size-4 text-[var(--accent)]' />
					<span>{t('nav.command')}</span>
				</div>
				<kbd class='rounded border border-[var(--border-default)] bg-[var(--bg-surface)] px-2 py-0.5 font-mono text-[10px] text-[var(--text-muted)]'>
					Buscar
				</kbd>
			</button>

			<ul class='flex flex-col gap-1'>
				<li>
					<a
						href={`${homePath}#projects`}
						data-mobile-link
						class='flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]'
					>
						<span>{t('nav.projects')}</span>
						<span class='font-mono text-xs text-[var(--text-muted)]'>01</span>
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#experience`}
						data-mobile-link
						class='flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]'
					>
						<span>{t('nav.experience')}</span>
						<span class='font-mono text-xs text-[var(--text-muted)]'>02</span>
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#about-me`}
						data-mobile-link
						class='flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]'
					>
						<span>{t('nav.about')}</span>
						<span class='font-mono text-xs text-[var(--text-muted)]'>03</span>
					</a>
				</li>
				<li>
					<a
						href={translatePath('/blog')}
						data-mobile-link
						class='flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]'
					>
						<span>{t('nav.blog')}</span>
						<LineIcon name='arrow-up-right' class='size-3.5 text-[var(--text-muted)]' />
					</a>
				</li>
				<li>
					<a
						href={`${homePath}#contact`}
						data-mobile-link
						class='flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]'
					>
						<span>{t('nav.contact')}</span>
						<span class='font-mono text-xs text-[var(--text-muted)]'>04</span>
					</a>
				</li>
			</ul>

			<!-- Mobile Availability Status -->
			<div class='mt-3 border-t border-[var(--border-subtle)] pt-3'>
				<a
					href={`${homePath}#contact`}
					data-mobile-link
					class='flex items-center gap-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
				>
					<span class='relative flex size-2 shrink-0'>
						<span
							class='status-dot-pulse absolute inline-flex h-full w-full rounded-full bg-[var(--status-online)]'
						></span>
						<span class='relative inline-flex size-2 rounded-full bg-[var(--status-online)]'></span>
					</span>
					<span class='truncate'>{t('nav.available')}</span>
				</a>
			</div>

			<div class='mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-subtle)] pt-3'>
				<div class='flex items-center gap-2'>
					<LangSelector />
					<ThemeToggle />
				</div>
				<a
					href='/FabianHerrera_CV.pdf'
					download='FabianHerreraCV.pdf'
					class='inline-flex h-9 items-center gap-1.5 rounded-md border border-[var(--border-default)] bg-[var(--bg-elevated)] px-3 text-xs font-medium text-[var(--text-primary)]'
				>
					<LineIcon name='download' class='size-3.5' />
					<span>{t('btn.downloadCV')}</span>
				</a>
			</div>
		</div>
	</Container>
</header>

<script>
	function initHeader() {
		const menuBtn = document.getElementById('mobile-menu-btn')
		const menuPanel = document.getElementById('mobile-menu-panel')
		const openIcon = document.getElementById('menu-icon-open')
		const closeIcon = document.getElementById('menu-icon-close')
		const mobileLinks = document.querySelectorAll('[data-mobile-link]')
		const cmdkTriggers = document.querySelectorAll('[data-open-cmdk]')

		cmdkTriggers.forEach((btn) => {
			if (btn.hasAttribute('data-cmdk-bound')) return
			btn.setAttribute('data-cmdk-bound', 'true')
			btn.addEventListener('click', () => {
				window.dispatchEvent(new CustomEvent('open-command-palette'))
			})
		})

		if (!menuBtn || !menuPanel || menuBtn.hasAttribute('data-bound')) return
		menuBtn.setAttribute('data-bound', 'true')

		const toggleMenu = (forceClose = false) => {
			const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true'
			const nextState = forceClose ? false : !isExpanded
			menuBtn.setAttribute('aria-expanded', String(nextState))
			menuPanel.classList.toggle('hidden', !nextState)
			openIcon?.classList.toggle('hidden', nextState)
			closeIcon?.classList.toggle('hidden', !nextState)
		}

		menuBtn.addEventListener('click', () => toggleMenu())
		mobileLinks.forEach((link) => {
			link.addEventListener('click', () => toggleMenu(true))
		})
	}

	initHeader()
	document.addEventListener('astro:after-swap', initHeader)
</script>
