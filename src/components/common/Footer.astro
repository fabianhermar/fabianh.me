---
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Logo from '@/components/ui/Logo.astro'
import { sanitizeHtml } from '@/helpers/satinizeHTML'
import { getI18N } from '@/i18n'
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<footer class='border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-12 md:py-16'>
	<Container>
		<div class='grid grid-cols-1 gap-10 md:grid-cols-12'>
			<!-- Brand, Unified Bio & Brand Tag (5 cols) -->
			<div class='md:col-span-5'>
				<a
					href={translatePath('/')}
					aria-label='Volver al inicio — Fabian Herrera'
					class='group inline-flex items-center gap-3 text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]'
				>
					<Logo class='size-9 transition-transform duration-200 group-hover:scale-105' idSuffix='footer' />
					<div class='flex flex-wrap items-baseline gap-2'>
						<span class='font-heading text-lg font-bold tracking-tight'>
							Fabian Herrera
						</span>
						<span class='text-xs text-[var(--text-muted)]'>·</span>
						<span class='font-serif text-sm italic text-[var(--text-secondary)]'>
							{i18n.landing.brand_tag}
						</span>
					</div>
				</a>

				<p class='mt-3 max-w-sm text-xs leading-relaxed text-[var(--text-secondary)]'>
					{i18n.SEO.description}
				</p>

				<div class='mt-4 flex items-center gap-2'>
					<a
						href='https://github.com/FabianHermar'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='GitHub de Fabian Herrera'
						class='inline-flex size-8 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='github' class='size-3.5' />
					</a>
					<a
						href='https://www.linkedin.com/in/fabianhmz/'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='LinkedIn de Fabian Herrera'
						class='inline-flex size-8 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='linkedin' class='size-3.5' />
					</a>
					<a
						href='https://x.com/FabianHermar'
						target='_blank'
						rel='noopener noreferrer'
						aria-label='X (Twitter) de Fabian Herrera'
						class='inline-flex size-8 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='x' class='size-3.5' />
					</a>
					<a
						href='mailto:ctofabian@gmail.com'
						aria-label='Enviar correo a ctofabian@gmail.com'
						class='inline-flex size-8 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-base)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]'
					>
						<LineIcon name='mail' class='size-3.5' />
					</a>
				</div>
			</div>

			<!-- Sitemap & Resources (7 cols) -->
			<div class='grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7'>
				<div>
					<h3 class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)]'>
						Navegación
					</h3>
					<ul class='mt-3 space-y-2 text-xs text-[var(--text-secondary)]'>
						<li>
							<a class='hover:text-[var(--accent)] transition-colors' href={translatePath('/')}>
								Inicio
							</a>
						</li>
						<li>
							<a class='hover:text-[var(--accent)] transition-colors' href={translatePath('/proyectos')}>
								{t('footer.projects')}
							</a>
						</li>
						<li>
							<a class='hover:text-[var(--accent)] transition-colors' href={translatePath('/sobre-mi')}>
								{t('footer.about')}
							</a>
						</li>
						<li>
							<a class='hover:text-[var(--accent)] transition-colors' href={translatePath('/blog')}>
								{t('footer.blog')}
							</a>
						</li>
						<li>
							<a class='hover:text-[var(--accent)] transition-colors' href={translatePath('/guia-de-estilo')}>
								{t('footer.style')}
							</a>
						</li>
					</ul>
				</div>

				<div>
					<h3 class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)]'>
						Proyectos
					</h3>
					<ul class='mt-3 space-y-2 text-xs text-[var(--text-secondary)]'>
						<li>
							<a
								class='inline-flex items-center gap-1 hover:text-[var(--accent)] transition-colors'
								href='https://studio.fabianh.me'
								target='_blank'
								rel='noopener noreferrer'
							>
								<span>ClearCut Studio</span>
								<LineIcon name='arrow-up-right' class='size-3' />
							</a>
						</li>
						<li>
							<a
								class='inline-flex items-center gap-1 hover:text-[var(--accent)] transition-colors'
								href='https://boxode.org'
								target='_blank'
								rel='noopener noreferrer'
							>
								<span>Boxode</span>
								<LineIcon name='arrow-up-right' class='size-3' />
							</a>
						</li>
						<li>
							<a
								class='inline-flex items-center gap-1 hover:text-[var(--accent)] transition-colors'
								href='https://ui.fabianh.me'
								target='_blank'
								rel='noopener noreferrer'
							>
								<span>Dune UI</span>
								<LineIcon name='arrow-up-right' class='size-3' />
							</a>
						</li>
					</ul>
				</div>

				<div>
					<h3 class='font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)]'>
						Recursos
					</h3>
					<ul class='mt-3 space-y-2 text-xs text-[var(--text-secondary)]'>
						<li>
							<a
								class='inline-flex items-center gap-1.5 hover:text-[var(--accent)] transition-colors'
								href='/FabianHerrera_CV.pdf'
								download='FabianHerreraCV.pdf'
							>
								<LineIcon name='download' class='size-3' />
								<span>{t('btn.downloadCV')}</span>
							</a>
						</li>
						<li>
							<a
								class='inline-flex items-center gap-1.5 hover:text-[var(--accent)] transition-colors'
								href='https://drive.google.com/file/d/1UKzGLJSSRQ5h7mvoZD7lJGE2NGqEX3pg/view?usp=sharing'
								target='_blank'
								rel='noopener noreferrer'
							>
								<span>{t('btn.digitalCV')}</span>
								<LineIcon name='arrow-up-right' class='size-3' />
							</a>
						</li>
						<li>
							<button
								type='button'
								data-open-cmdk
								class='inline-flex items-center gap-1.5 text-left hover:text-[var(--accent)] transition-colors'
							>
								<LineIcon name='command' class='size-3' />
								<span>Cmd / Ctrl + K</span>
							</button>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Bottom Legal & Stack Bar -->
		<div class='mt-10 flex flex-col items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-6 text-xs text-[var(--text-muted)] sm:flex-row'>
			<p class='font-mono tabular-nums'>
				© {new Date().getFullYear()} Fabian Herrera. Zacatecas, México.
			</p>
			<p
				class='text-center sm:text-right'
				set:html={sanitizeHtml(t('footer.small'))}
			/>
		</div>
	</Container>
</footer>
