---
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Pill from '@/components/ui/pill.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'
import { getI18N } from '@/i18n'

const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
const projects = await getCollection('projects', ({ data }) => {
	return data.lang === lang
})
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const featuredTitles = ['ClearCut Studio', 'Boxode Website', 'Dune UI']
const featuredProjects = projects
	.filter((p) => featuredTitles.includes(p.data.title))
	.sort((a, b) => featuredTitles.indexOf(a.data.title) - featuredTitles.indexOf(b.data.title))

const otherProjects = projects.filter((p) => !featuredTitles.includes(p.data.title))

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

const isEs = lang === 'es'
const isDe = lang === 'de'

const t = {
	title: isEs ? 'Archivo de Proyectos' : isDe ? 'Projektarchiv' : 'Projects Archive',
	subtitle: isEs
		? 'Selección completa de productos web, sistemas de diseño y experimentos técnicos.'
		: isDe
			? 'Vollständige Auswahl an Webprodukten, Designsystemen und technischen Projekten.'
			: 'Complete selection of web products, design systems, and technical projects.',
	goBack: isEs ? 'Volver al inicio' : isDe ? 'Zurück' : 'Back to home',
	featured: isEs ? 'Casos de Estudio Principales' : isDe ? 'Hauptprojekte' : 'Featured Case Studies',
	more: isEs ? 'Otros Proyectos' : isDe ? 'Weitere Projekte' : 'Additional Projects',
	live: isEs ? 'Ver proyecto' : isDe ? 'Live' : 'Live',
	code: isEs ? 'Código' : isDe ? 'Code' : 'Code',
}
---

<Layout title={`${t.title} | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<!-- Back Link -->
			<div class='mb-8'>
				<a
					href={translatePath('/')}
					class='inline-flex items-center gap-2 font-mono text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]'
				>
					<LineIcon name='arrow-left' class='size-3.5' />
					<span>{t.goBack}</span>
				</a>
			</div>

			<!-- Header -->
			<div class='mb-14 border-b border-[var(--border-subtle)] pb-10'>
				<span class='section-number'>ARCHIVE</span>
				<h1 class='mt-2 text-scale-display text-[var(--text-primary)]'>
					{t.title}
				</h1>
				<p class='mt-4 max-w-2xl text-scale-body-lg text-[var(--text-secondary)]'>
					{t.subtitle}
				</p>
			</div>

			<!-- Featured Projects Grid -->
			{featuredProjects.length > 0 && (
				<div class='mb-16'>
					<h2 class='mb-6 text-scale-h2 text-[var(--text-primary)]'>{t.featured}</h2>
					<div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'>
						{featuredProjects.map((project, idx) => (
							<article class='surface-card surface-card-interactive flex flex-col justify-between overflow-hidden p-6'>
								<div>
									<div class='mb-4 flex items-center justify-between font-mono text-xs text-[var(--text-muted)]'>
										<span class='text-[var(--accent)] font-semibold'>/0{idx + 1}</span>
										<span class='tabular-nums'>
											{project.data.date ? project.data.date.getFullYear() : ''}
										</span>
									</div>

									{project.data.image && (
										<div class='mb-5 aspect-[16/10] w-full overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)]'>
											<img
												src={project.data.image}
												alt={project.data.title}
												width='600'
												height='375'
												loading='lazy'
												class='h-full w-full object-cover object-top'
											/>
										</div>
									)}

									<h3 class='text-scale-h3 text-[var(--text-primary)]'>
										{project.data.title}
									</h3>
									<p class='mt-2 text-sm leading-relaxed text-[var(--text-secondary)]'>
										{project.data.description}
									</p>
								</div>

								<div class='mt-6 border-t border-[var(--border-subtle)] pt-4'>
									<div class='mb-4 flex flex-wrap gap-1.5'>
										{project.data.technologies?.map((tech: string) => (
											<Pill text={tech} />
										))}
									</div>

									<div class='flex items-center gap-3 text-xs font-semibold'>
										{project.data.externalLink && (
											<a
												href={project.data.externalLink}
												target='_blank'
												rel='noopener noreferrer'
												class='inline-flex items-center gap-1 text-[var(--accent)] hover:underline underline-offset-4'
											>
												<span>{t.live}</span>
												<LineIcon name='arrow-up-right' class='size-3.5' />
											</a>
										)}
										{project.data.githubLink && (
											<a
												href={project.data.githubLink}
												target='_blank'
												rel='noopener noreferrer'
												class='inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
											>
												<LineIcon name='github' class='size-3.5' />
												<span>{t.code}</span>
											</a>
										)}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			)}

			<!-- Other Projects -->
			{otherProjects.length > 0 && (
				<div>
					<h2 class='mb-6 text-scale-h2 text-[var(--text-primary)]'>{t.more}</h2>
					<div class='grid grid-cols-1 gap-6 md:grid-cols-2'>
						{otherProjects.map((project) => (
							<article class='surface-card surface-card-interactive flex flex-col justify-between p-6'>
								<div>
									<div class='flex items-center justify-between gap-2'>
										<h3 class='text-scale-h3 text-[var(--text-primary)]'>
											{project.data.title}
										</h3>
										<span class='font-mono tabular-nums text-xs text-[var(--text-muted)]'>
											{project.data.date ? project.data.date.getFullYear() : ''}
										</span>
									</div>
									<p class='mt-2 text-sm leading-relaxed text-[var(--text-secondary)]'>
										{project.data.description}
									</p>
								</div>

								<div class='mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-subtle)] pt-4'>
									<div class='flex flex-wrap gap-1.5'>
										{project.data.technologies?.map((tech: string) => (
											<Pill text={tech} />
										))}
									</div>
									<div class='flex items-center gap-3 text-xs font-semibold'>
										{project.data.externalLink && (
											<a
												href={project.data.externalLink}
												target='_blank'
												rel='noopener noreferrer'
												class='inline-flex items-center gap-1 text-[var(--accent)] hover:underline'
											>
												<span>{t.live}</span>
												<LineIcon name='arrow-up-right' class='size-3.5' />
											</a>
										)}
										{project.data.githubLink && (
											<a
												href={project.data.githubLink}
												target='_blank'
												rel='noopener noreferrer'
												class='inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
											>
												<LineIcon name='github' class='size-3.5' />
												<span>{t.code}</span>
											</a>
										)}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			)}
		</Container>
	</section>
</Layout>
