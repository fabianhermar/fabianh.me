---
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Layout from '@/layouts/Layout.astro'
import { getI18N } from '@/i18n'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'
import { Image } from 'astro:assets'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
---

<Layout title={`${i18n.landing.moreinfo.title} | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<!-- Back Link -->
			<div class='mb-8'>
				<a
					href={translatePath('/')}
					class='inline-flex items-center gap-2 font-mono text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]'
				>
					<LineIcon name='arrow-left' class='size-3.5' />
					<span>Inicio</span>
				</a>
			</div>

			<!-- Editorial Profile Header (12-column grid) -->
			<div class='grid grid-cols-1 items-start gap-10 border-b border-[var(--border-subtle)] pb-16 lg:grid-cols-12 lg:gap-12'>
				<div class='lg:col-span-7'>
					<div class='mb-4 flex items-center gap-2'>
						<span class='section-number'>PERFIL</span>
						<span class='h-px w-8 bg-[var(--border-default)]' aria-hidden='true'></span>
						<span class='font-mono text-xs text-[var(--text-muted)]'>
							{i18n.landing.brand_tag}
						</span>
					</div>

					<h1 class='text-scale-display text-[var(--text-primary)]'>
						{i18n.landing.moreinfo.title}
					</h1>

					<div class='mt-6 space-y-4 text-base leading-relaxed text-[var(--text-secondary)]'>
						<p class='font-medium text-[var(--text-primary)]'>
							{i18n.landing.moreinfo.who['1']}
						</p>
						<p>
							{i18n.landing.moreinfo.who['2'].fp}{' '}
							<strong class='font-semibold text-[var(--text-primary)]'>
								{i18n.landing.moreinfo.who['2'].sp}
							</strong>
							,{' '}
							<strong class='font-semibold text-[var(--text-primary)]'>
								{i18n.landing.moreinfo.who['2'].tp}
							</strong>{' '}
							{i18n.landing.moreinfo.who['2'].ftp}{' '}
							<strong class='font-semibold text-[var(--text-primary)]'>
								{i18n.landing.moreinfo.who['2'].ffp}
							</strong>
						</p>
						<p class='border-l-2 border-[var(--accent)] pl-4 font-serif italic text-[var(--text-primary)]'>
							{i18n.landing.moreinfo.who['3']}
						</p>
					</div>
				</div>

				<div class='lg:col-span-5 flex justify-center lg:justify-end'>
					<figure class='surface-card relative w-full max-w-[340px] sm:max-w-[370px] overflow-hidden p-3 rounded-2xl shadow-sm'>
						<div class='relative aspect-[4/5] w-full overflow-hidden rounded-xl bg-gradient-to-b from-[var(--bg-elevated)] via-[var(--bg-surface)] to-[var(--bg-elevated)]'>
							<div
								class='pointer-events-none absolute inset-0 bg-radial from-[var(--accent)]/15 via-transparent to-transparent opacity-80'
								aria-hidden='true'
							></div>
							<Image
								src='/me.webp'
								alt='Fabian Herrera — Desarrollador web fullstack'
								width={523}
								height={824}
								loading='eager'
								class='relative z-10 h-full w-full object-contain object-bottom pt-3'
								style='mask-image: linear-gradient(to bottom, black 86%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 86%, transparent 100%);'
							/>
						</div>
						<figcaption class='mt-3 flex items-center justify-between border-t border-[var(--border-subtle)] pt-3 px-1 font-mono text-xs text-[var(--text-muted)]'>
							<span>Fabian Herrera</span>
							<span>UTNA · 2019–2025</span>
						</figcaption>
					</figure>
				</div>
			</div>

			<!-- Story Timeline -->
			<div class='py-16 border-b border-[var(--border-subtle)]'>
				<div class='mb-10'>
					<span class='section-number'>TRAYECTORIA</span>
					<h2 class='mt-1 text-scale-h2 text-[var(--text-primary)]'>
						{i18n.landing.moreinfo.who.title}
					</h2>
				</div>

				<div class='grid grid-cols-1 gap-6 md:grid-cols-3'>
					{i18n.landing.moreinfo.who.story?.map((paragraph: string, index: number) => (
						<article class='surface-card flex flex-col justify-between p-6 md:p-7'>
							<div>
								<span class='font-mono tabular-nums text-xs font-semibold text-[var(--accent)]'>
									/0{index + 1}
								</span>
								<p class='mt-4 text-sm leading-relaxed text-[var(--text-secondary)]'>
									{paragraph}
								</p>
							</div>
						</article>
					))}
				</div>
			</div>

			<!-- Philosophy Quote -->
			<div class='pt-16'>
				<div class='surface-card flex flex-col items-center gap-6 p-8 sm:flex-row sm:gap-8 md:p-10'>
					<Image
						src='/me2.avif'
						alt='Retrato de Fabian Herrera'
						width={96}
						height={96}
						loading='lazy'
						class='size-20 shrink-0 rounded-full border border-[var(--border-default)] object-cover sm:size-24'
					/>
					<div>
						<blockquote class='font-serif text-xl italic leading-relaxed text-[var(--text-primary)] md:text-2xl'>
							"{i18n.landing.moreinfo.who.quote}"
						</blockquote>
						<p class='mt-2 font-mono text-xs text-[var(--text-muted)]'>
							— Fabian Herrera · {i18n.landing.brand_tag}
						</p>
					</div>
				</div>
			</div>
		</Container>
	</section>
</Layout>
