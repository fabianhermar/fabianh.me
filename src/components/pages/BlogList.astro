---
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { getLangFromUrl } from '@/i18n/utils'
import { getI18N } from '@/i18n'

const lang = getLangFromUrl(Astro.url)
const posts = await getCollection('blog', ({ data }) => {
	return data.lang === lang
})
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const totalPosts = posts.length
---

<Layout title={`Blog | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<!-- Header -->
			<div class='mb-14 flex flex-col justify-between gap-6 border-b border-[var(--border-subtle)] pb-10 md:flex-row md:items-end'>
				<div class='max-w-2xl'>
					<span class='section-number'>EDITORIAL</span>
					<h1 class='mt-2 text-scale-display text-[var(--text-primary)]'>
						Blog
					</h1>
					<p class='mt-4 text-scale-body-lg text-[var(--text-secondary)]'>
						Artículos, notas técnicas y reflexiones sobre desarrollo web fullstack, arquitectura frontend y diseño de interfaces.
					</p>
				</div>

				<div class='surface-card flex items-center gap-6 px-5 py-3.5 self-start md:self-end'>
					<div>
						<p class='font-heading tabular-nums text-2xl font-bold text-[var(--text-primary)]'>
							{totalPosts}
						</p>
						<p class='font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]'>
							Artículos
						</p>
					</div>
					<div class='h-8 w-px bg-[var(--border-subtle)]'></div>
					<div>
						<p class='font-heading tabular-nums text-2xl font-bold text-[var(--text-primary)]'>
							3
						</p>
						<p class='font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]'>
							Idiomas
						</p>
					</div>
				</div>
			</div>

			<!-- Posts Grid -->
			<div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'>
				{posts.map((post) => (
					<a
						href={`/${lang === 'es' ? 'blog' : lang + '/blog'}/${post.id.split('/').pop()}`}
						class='surface-card surface-card-interactive group flex flex-col overflow-hidden p-5'
					>
						<div class='relative mb-4 aspect-video w-full overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)]'>
							{post.data.image ? (
								<img
									src={post.data.image}
									alt={post.data.title}
									width='640'
									height='360'
									loading='lazy'
									class='h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]'
								/>
							) : null}
							{post.data.category && (
								<span class=' absolute top-2.5 left-2.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-[var(--text-primary)]'>
									{post.data.category}
								</span>
							)}
						</div>

						<div class='flex flex-1 flex-col justify-between gap-4'>
							<div>
								<h2 class='text-scale-h3 text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] line-clamp-2'>
									{post.data.title}
								</h2>
								<p class='mt-2 text-sm leading-relaxed text-[var(--text-secondary)] line-clamp-2'>
									{post.data.description}
								</p>
							</div>

							<div class='flex items-center justify-between border-t border-[var(--border-subtle)] pt-3 font-mono text-xs text-[var(--text-muted)]'>
								<span>{post.data.author || 'Fabian Herrera'}</span>
								<time class='tabular-nums'>
									{post.data.pubDate.toLocaleDateString(lang, {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
							</div>
						</div>
					</a>
				))}
			</div>
		</Container>
	</section>
</Layout>
