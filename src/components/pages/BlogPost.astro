---
import Container from '@/components/common/Container.astro'
import LineIcon from '@/components/ui/LineIcon.astro'
import Layout from '@/layouts/Layout.astro'
import { getI18N } from '@/i18n'
import { render } from 'astro:content'
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils'
import CopyLinkButton from '@/components/pages/CopyLinkButton.tsx'

const { post } = Astro.props
const { Content } = await render(post)
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
---

<Layout title={`${post.data.title} | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<article class='mx-auto max-w-3xl'>
				<a
					href={translatePath('/blog')}
					class='inline-flex items-center gap-2 font-mono text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]'
				>
					<LineIcon name='arrow-left' class='size-3.5' />
					<span>Volver al blog</span>
				</a>

				<div class='mt-6 flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]'>
					<span class='text-[var(--accent)] font-semibold'>{post.data.category || 'ARTÍCULO'}</span>
					<span>·</span>
					<time class='tabular-nums'>
						{post.data.pubDate.toLocaleDateString(lang, {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
					<span>·</span>
					<span class='tabular-nums'>
						{(post.data.readTime || 3) === 1 ? '1 MIN' : `${post.data.readTime || 3} MIN`}
					</span>
				</div>

				<h1 class='mt-4 text-scale-h1 text-balance text-[var(--text-primary)]'>
					{post.data.title}
				</h1>

				<div class='mt-6 flex flex-col gap-4 border-b border-[var(--border-subtle)] pb-6 sm:flex-row sm:items-center sm:justify-between'>
					<div>
						<p class='font-heading text-sm font-bold text-[var(--text-primary)]'>
							{post.data.author || 'Fabian Herrera'}
						</p>
						<p class='font-mono text-xs text-[var(--text-muted)]'>
							Desarrollador web fullstack con más de 2 años de experiencia
						</p>
					</div>
					<CopyLinkButton client:idle />
				</div>

				{post.data.image && (
					<div class='mt-8 overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)]'>
						<img
							src={post.data.image}
							alt={post.data.title}
							width='960'
							height='420'
							class='aspect-[21/9] w-full object-cover'
						/>
					</div>
				)}

				<div class='prose prose-neutral dark:prose-invert mx-auto mt-10 max-w-none prose-headings:font-heading prose-a:text-[var(--accent)]'>
					<Content />
				</div>
			</article>
		</Container>
	</section>
</Layout>
