---
import Container from '@/components/common/Container.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { getLangFromUrl } from '@/i18n/utils'
import { getI18N } from '@/i18n'

const lang = getLangFromUrl(Astro.url)
const projects = await getCollection('projects', ({ data }) => {
	return data.lang === lang
})
projects.sort((a, b) => {
	if (!a.data.date || !b.data.date) return 0
	return b.data.date.valueOf() - a.data.date.valueOf()
})

const posts = await getCollection('blog', ({ data }) => {
	return data.lang === lang
})
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<Layout title={`Archivo | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<div class='mb-12 border-b border-[var(--border-subtle)] pb-8'>
				<span class='section-number'>INDEX</span>
				<h1 class='mt-2 text-scale-display text-[var(--text-primary)]'>
					Archivo
				</h1>
				<p class='mt-3 text-scale-body-lg text-[var(--text-secondary)]'>
					Índice cronológico de proyectos y publicaciones.
				</p>
			</div>

			<div class='grid grid-cols-1 gap-10 lg:grid-cols-2'>
				<div class='surface-card p-6 md:p-8'>
					<h2 class='border-b border-[var(--border-subtle)] pb-3 text-scale-h3 text-[var(--text-primary)]'>
						Proyectos ({projects.length})
					</h2>
					<ul class='mt-4 divide-y divide-[var(--border-subtle)]'>
						{projects.map((p) => (
							<li class='flex items-center justify-between py-3 text-sm'>
								<span class='font-medium text-[var(--text-primary)]'>{p.data.title}</span>
								<time class='font-mono tabular-nums text-xs text-[var(--text-muted)]'>
									{p.data.date
										? p.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'short' })
										: ''}
								</time>
							</li>
						))}
					</ul>
				</div>

				<div class='surface-card p-6 md:p-8'>
					<h2 class='border-b border-[var(--border-subtle)] pb-3 text-scale-h3 text-[var(--text-primary)]'>
						Blog ({posts.length})
					</h2>
					<ul class='mt-4 divide-y divide-[var(--border-subtle)]'>
						{posts.map((p) => (
							<li class='flex items-center justify-between gap-4 py-3 text-sm'>
								<a
									href={`/${lang === 'es' ? 'blog' : lang + '/blog'}/${p.id.split('/').pop()}`}
									class='font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors'
								>
									{p.data.title}
								</a>
								<time class='shrink-0 font-mono tabular-nums text-xs text-[var(--text-muted)]'>
									{p.data.pubDate.toLocaleDateString(lang, {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
							</li>
						))}
					</ul>
				</div>
			</div>
		</Container>
	</section>
</Layout>
