---
import Container from '@/components/common/Container.astro'
import Colors from '@/components/styleGuide/colors.astro'
import Elements from '@/components/styleGuide/elements.astro'
import Icons from '@/components/styleGuide/icons.astro'
import Typo from '@/components/styleGuide/typo.astro'
import Layout from '@/layouts/Layout.astro'

import { getI18N } from '@/i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<Layout title={`${i18n.styleguide.title} | ${i18n.SEO.title}`}>
	<section class='py-12 md:py-20'>
		<Container>
			<div class='mb-14 border-b border-[var(--border-subtle)] pb-10'>
				<span class='section-number'>{i18n.styleguide.badge}</span>
				<h1 class='mt-2 text-scale-display text-[var(--text-primary)]'>
					{i18n.styleguide.title}
				</h1>
				<p class='mt-4 max-w-2xl text-scale-body-lg text-[var(--text-secondary)]'>
					{i18n.styleguide.subtitle}
				</p>
			</div>

			<div class='space-y-16'>
				<Colors />
				<Typo />
				<Elements />
				<Icons />
			</div>
		</Container>
	</section>
</Layout>
